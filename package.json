{
  "homepage": "https://tyngw.github.io/test-modeling-app/",
  "name": "test-modeling-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "11.11.4",
    "@emotion/styled": "11.11.0",
    "@mui/icons-material": "5.16.14",
    "@mui/material": "5.16.14",
    "@testing-library/jest-dom": "6.4.2",
    "@testing-library/user-event": "14.5.2",
    "@types/crypto-js": "4.2.2",
    "@types/react-dom": "19.0.4",
    "axios": "1.15.0",
    "canvas": "2.11.2",
    "crypto-js": "4.2.0",
    "next": "15.5.15",
    "node-polyfill-webpack-plugin": "4.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-ga4": "2.1.0",
    "react-scripts": "5.0.1",
    "stream-http": "3.2.0",
    "web-vitals": "3.5.2"
  },
  "overrides": {
    "axios": "1.15.0",
    "next": "15.5.15",
    "lodash": "4.18.1",
    "serialize-javascript": "7.0.5",
    "tar": "7.5.11",
    "node-forge": "1.4.0",
    "jsonpath": "1.3.0",
    "svgo": "2.8.1",
    "picomatch": "4.0.4",
    "path-to-regexp": "0.1.13",
    "yaml": "2.8.3",
    "handlebars": "4.7.9",
    "flatted": "3.4.2",
    "bfj": "9.1.3",
    "glob": "10.5.0",
    "brace-expansion": "1.1.13",
    "diff": "4.0.4",
    "nth-check": "2.1.1",
    "postcss": "8.4.31",
    "webpack-dev-server": "5.2.3"
  },
  "scripts": {
    "dev": "next dev",
    "start": "npx serve@latest ./build",
    "build": "tsc && next build",
    "extension:build": "./scripts/build-extension.sh",
    "extension:build:quick": "./scripts/build-extension-quick.sh",
    "extension:package": "npm run extension:build && cp LICENSE extension/LICENSE && cd extension && npx vsce package --out ../test-modeling-app.vsix",
    "extension:build:all": "npm run extension:build && npm run extension:package",
    "build:all": "npm run build && npm run extension:build:all",
    "test": "react-scripts test --watchAll=false",
    "test:watch": "react-scripts test",
    "eject": "react-scripts eject",
    "deploy": "rm -rf docs && npm run build && mv build docs",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepare": "husky install"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.14.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^29.5.14",
    "@types/uuid": "^10.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.3.3",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^16.1.0",
    "postcss-cli": "^11.0.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}

{
  "homepage": "https://tyngw.github.io/test-modeling-app/",
  "name": "test-modeling-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.13",
    "@mui/material": "^5.15.13",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/crypto-js": "^4.2.2",
    "@types/react-dom": "^19.0.4",
    "canvas": "^2.11.2",
    "crypto-js": "^4.2.0",
    "next": "^16.2.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-ga4": "^2.1.0",
    "stream-http": "^3.2.0",
    "uuid": "^9.0.1",
    "web-vitals": "^3.5.2"
  },
  "overrides": {
    "nth-check": "2.1.1",
    "postcss": "8.5.14"
  },
  "scripts": {
    "dev": "next dev",
    "start": "npx serve@latest ./build",
    "build": "tsc && next build",
    "extension:build": "./scripts/build-extension.sh",
    "extension:build:quick": "./scripts/build-extension-quick.sh",
    "extension:package": "npm run extension:build && cp LICENSE extension/LICENSE && cd extension && npx vsce package --out ../test-modeling-app.vsix",
    "extension:build:all": "npm run extension:build && npm run extension:package",
    "build:all": "npm run build && npm run extension:build:all",
    "test": "jest --config src/jest.config.ts --runInBand",
    "test:watch": "jest --config src/jest.config.ts --watch",
    "deploy": "rm -rf docs && npm run build && mv build docs",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepare": "husky install"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.14.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^29.5.14",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.3.3",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "husky": "^8.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.1.0",
    "postcss-cli": "^11.0.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}

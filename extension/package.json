{
  "name": "test-modeling-app-extension",
  "displayName": "Test Modeling App",
  "description": "VSCode extension for Test Modeling App",
  "version": "0.1.0",
  "publisher": "tyngw",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:testModelingApp.openModeler",
    "onCommand:testModelingApp.openInModelingView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "testModelingApp.openModeler",
        "title": "Open Test Modeling App",
        "category": "Test Modeling"
      },
      {
        "command": "testModelingApp.openInModelingView",
        "title": "Open in Test Modeling View",
        "category": "Test Modeling"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "testModelingApp.openInModelingView",
          "when": "resourceExtname == .json",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "testModelingApp.openInModelingView",
          "when": "resourceExtname == .json",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^16.x",
    "@types/vscode": "^1.60.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {}
}
